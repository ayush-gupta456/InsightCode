PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Required in production; use a cryptographically random value of at least 32 characters.
JWT_SECRET=
# Leave empty for single-process local development storage.
MONGODB_URI=
REDIS_URL=
DATA_DIR=./data
# Both are required for AI. Select a model available in your Google AI account.
GEMINI_API_KEY=
GEMINI_MODEL=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin that serves /api; use the frontend origin when /api is reverse-proxied.
PUBLIC_API_ORIGIN=http://127.0.0.1:5173
# Base64 encoding of 32 cryptographically random bytes.
INTEGRATION_ENCRYPTION_KEY=
# Optional isolated analyzers. Build workers/Dockerfile, then set the image tag.
ANALYZER_IMAGE=
ANALYZERS=eslint,typescript,ruff,bandit
WORKER_TEMP_DIR=

# Optional account recovery and Google sign-in (backend only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Gmail SMTP takes priority over Resend when configured (Render Free blocks SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
